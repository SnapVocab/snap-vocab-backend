    "\n",
    "\n",
    "def evaluate_detection(detections, ground_truth, iou_threshold=0.5, allowed_labels=None):\n",
    "    order = sorted(range(len(detections)), key=lambda i: -detections[i].get(\"score\", 0.0))\n",
    "    matched_gt, matched_det, ignored_det = set(), set(), set()\n",
    "\n",
    "    def _ioa(det_box, gt_box):\n",
    "        \"\"\"Giao / diện tích DETECTION — chuẩn Open Images cho group box (IsGroupOf).\"\"\"\n",
    "        x1 = max(det_box[0], gt_box[0]); y1 = max(det_box[1], gt_box[1])\n",
    "        x2 = min(det_box[2], gt_box[2]); y2 = min(det_box[3], gt_box[3])\n",
    "        inter = max(0, x2 - x1) * max(0, y2 - y1)\n",
    "        det_area = max(1e-6, (det_box[2] - det_box[0]) * (det_box[3] - det_box[1]))\n",
    "        return inter / det_area\n",
    "\n",
    "    for di in order:\n",
    "        d = detections[di]\n",
    "        best_iou, best_gi, best_is_group = 0.0, -1, False\n",
    "        for gi, g in enumerate(ground_truth):\n",
    "            if not labels_match(d[\"label\"], g[\"label\"]):\n",
    "                continue\n",
    "            if g.get(\"is_group\"):\n",
    "                # group box: mọi box đơn so IoU đều trượt -> dùng IoA >= 0.5;\n",
    "                # det đầu khớp = TP, các det sau cùng group = ignore\n",
    "                ioa = _ioa(d[\"box\"], g[\"box\"])\n",
    "                if ioa >= 0.5 and ioa > best_iou:\n",
    "                    best_iou, best_gi, best_is_group = ioa, gi, True\n",
    "            else:\n",
    "                if gi in matched_gt:\n",
    "                    continue\n",
    "                iou = compute_iou(d[\"box\"], g[\"box\"])\n",
    "                if iou > best_iou:\n",
    "                    best_iou, best_gi, best_is_group = iou, gi, False\n",
    "        if best_gi >= 0 and (best_is_group or best_iou >= iou_threshold):\n",
    "            if best_is_group and best_gi in matched_gt:\n",
    "                ignored_det.add(di)\n",
    "            else:\n",
    "                matched_gt.add(best_gi); matched_det.add(di)\n",
    "        elif allowed_labels is not None and map_label_to_vocab(d[\"label\"], allowed_labels) is None:\n",
    "            ignored_det.add(di)   # Open Images federated: lớp chưa verify -> ignore, không phạt FP\n",
    "\n",
    "    tp = len(matched_det)\n",
    "    fp = len(detections) - tp - len(ignored_det)\n",
    "    fn = len(ground_truth) - len(matched_gt)\n",
    "    precision = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n",
    "    recall = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",
    "    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0.0\n",
    "    return {\n",
    "        \"precision\": round(precision, 3), \"recall\": round(recall, 3), \"f1\": round(f1, 3),\n",
    "        \"true_positive\": tp, \"false_positive\": fp, \"false_negative\": fn,\n",
    "        \"ignored_detections\": len(ignored_det),\n",
    "        \"missed_objects\": [g[\"label\"] for gi, g in enumerate(ground_truth) if gi not in matched_gt],\n",
    "        \"extra_detections\": [detections[di][\"label\"] for di in range(len(detections))\n",
    "                             if di not in matched_det and di not in ignored_det],\n",
    "    }\n",
    "\n",
    "\n",
    "def evaluate_on_test_set(test_cases, extra_tags=None, label=\"\", visualize=True):\n",
    "    \"\"\"visualize=True: vẽ overlay GT-vs-dự-đoán cho TỪNG ảnh test (đặt False nếu chỉ cần chỉ số).\"\"\"\n",
    "    all_metrics = []\n",
    "    tot_tp = tot_fp = tot_fn = 0\n",
    "    w_tp = w_fp = w_fn = 0   # MỚI: đếm cấp độ TỪ (một từ dự đoán đúng nếu khớp bất kỳ từ GT nào,\n",
    "                             # không xét IoU) — thước đo sát mục tiêu flashcard: \"ảnh này pipeline\n",
    "                             # gọi tên đúng những vật gì?\", tách khỏi độ khít box.\n",
    "    for case in test_cases:\n",
    "        detections, _, _ = process_and_crop_flashcards(\n",
    "            case[\"image_path\"], save_metadata=False, show_plot=False,\n",
    "            extra_tags=case.get(\"extra_tags\", extra_tags),\n",
    "        )\n",
    "        m = evaluate_detection(detections, case[\"ground_truth\"], allowed_labels=case.get(\"allowed_labels\"))\n",
    "        if visualize:\n",
    "            draw_eval_overlay(case[\"image_path\"], detections, case[\"ground_truth\"], m)\n",
    "        m[\"image\"] = case[\"image_path\"]\n",
    "        all_metrics.append(m)\n",
    "        tot_tp += m[\"true_positive\"]; tot_fp += m[\"false_positive\"]; tot_fn += m[\"false_negative\"]\n",
    "        print(f\"[{case['image_path']}] P={m['precision']} R={m['recall']} F1={m['f1']}\")\n",
    "        if m[\"missed_objects\"]:\n",
    "            # In dạng text (trước đây chỉ nằm trong tiêu đề hình vẽ) để phân tích từ sót từ log\n",
    "            print(f\"   Bỏ sót: {sorted(set(m['missed_objects']))}\")\n",
    "        # cấp độ TỪ\n",
    "        pred_words = {d[\"label\"] for d in detections}\n",
    "        gt_words = {g[\"label\"] for g in case[\"ground_truth\"]}\n",
    "        allowed = case.get(\"allowed_labels\")\n",
    "        for p in pred_words:\n",
    "            if any(labels_match(p, g) for g in gt_words):\n",
    "                w_tp += 1\n",
    "            elif allowed is None or map_label_to_vocab(p, allowed) is not None:\n",
    "                w_fp += 1   # từ sai (nằm trong tập lớp đã verify); ngoài tập verify -> ignore\n",
    "        w_fn += sum(1 for g in gt_words if not any(labels_match(p, g) for p in pred_words))\n",
    "\n",
    "    avg_p = np.mean([m[\"precision\"] for m in all_metrics])\n",
    "    avg_r = np.mean([m[\"recall\"] for m in all_metrics])\n",
    "    avg_f1 = np.mean([m[\"f1\"] for m in all_metrics])\n",
    "    micro_p = tot_tp / (tot_tp + tot_fp) if (tot_tp + tot_fp) > 0 else 0.0\n",
    "    micro_r = tot_tp / (tot_tp + tot_fn) if (tot_tp + tot_fn) > 0 else 0.0\n",
    "    micro_f1 = 2 * micro_p * micro_r / (micro_p + micro_r) if (micro_p + micro_r) > 0 else 0.0\n",
    "    tag = f\" ({label})\" if label else \"\"\n",
    "    print(f\"\\n===== KẾT QUẢ TRÊN {len(test_cases)} ẢNH TEST{tag} =====\")\n",
    "    print(f\"MACRO (tb per-image):                P={avg_p:.3f} | R={avg_r:.3f} | F1={avg_f1:.3f}\")\n",
    "    print(f\"MICRO (cộng dồn TP/FP/FN, NÊN DÙNG): P={micro_p:.3f} | R={micro_r:.3f} | F1={micro_f1:.3f} \"\n",
    "          f\"(TP={tot_tp} FP={tot_fp} FN={tot_fn})\")\n",
    "    wp = w_tp / (w_tp + w_fp) if (w_tp + w_fp) else 0.0\n",
    "    wr = w_tp / (w_tp + w_fn) if (w_tp + w_fn) else 0.0\n",
    "    wf = 2 * wp * wr / (wp + wr) if (wp + wr) else 0.0\n",
    "    print(f\"WORD-LEVEL (độ phủ TỪ, không xét IoU — thước đo sát mục tiêu flashcard): \"\n",
    "          f\"P={wp:.3f} | R={wr:.3f} | F1={wf:.3f}\")\n",
    "    return all_metrics\n"
   ]
