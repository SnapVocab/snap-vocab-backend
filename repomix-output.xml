    "## Bước 3 — Chuẩn hoá nhãn + so khớp nhãn (kế thừa bản v8 đã sửa)\n",
    "\n",
    "- `caption_to_label`: trích **cụm danh từ cuối** của caption (\"a red vintage car parked...\" → \"car\",\n",
    "  \"traffic light on pole\" → \"traffic light\") — đây là từ đưa lên flashcard.\n",
    "- `is_scene_background_word`: chỉ áp cho tag MỘT TỪ (đã fix bug \"traffic light\" của bản cũ).\n",
    "- `labels_match`: đồng nghĩa WordNet + bảng alias + quan hệ hyponym→hypernym CÓ HƯỚNG (man → person,\n",
    "  sedan → car) — dùng cho đánh giá, để không phạt oan nhãn cụ thể hơn ground truth.\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import re\n",
    "import nltk\n",
    "from nltk.corpus import wordnet, words as nltk_words\n",
    "from nltk.stem import WordNetLemmatizer\n",
    "\n",
    "lemmatizer = WordNetLemmatizer()\n",
    "ENGLISH_WORDS = set(w.lower() for w in nltk_words.words())\n",
    "\n",
    "STRICT_DICTIONARY_FILTER = True   # True: chỉ nhận nhãn có trong từ điển (COCO); False: bộ lọc mềm (Internet)\n",
    "\n",
    "SCENE_BACKGROUND_STOPWORDS = {\n",
    "    \"wall\", \"floor\", \"ceiling\", \"sky\", \"room\", \"background\", \"shadow\", \"light\",\n",
    "    \"photo\", \"image\", \"picture\", \"texture\", \"pattern\", \"surface\", \"reflection\",\n",
    "    \"scene\", \"view\", \"outdoor\", \"indoor\", \"ground\", \"area\", \"space\",\n",
    "    # SỬA: tên CĂN PHÒNG là bối cảnh, không phải vật cắt được thành flashcard\n",
    "    # (\"kitchen\" từng lọt ra thành thẻ ở ảnh bếp F2-v12)\n",
    "    \"kitchen\", \"bathroom\", \"bedroom\", \"hallway\", \"interior\",\n",
    "}\n",
    "\n",
    "# Giới từ dùng để cắt caption: \"a red car parked ON the street\" -> chỉ giữ \"a red car parked\"\n",
    "_PREPOSITIONS = {\n",
    "    \"in\", \"on\", \"at\", \"with\", \"of\", \"near\", \"by\", \"under\", \"over\", \"behind\", \"beside\",\n",
    "    \"above\", \"below\", \"around\", \"against\", \"across\", \"during\", \"from\", \"to\", \"next\", \"front\",\n",
    "}\n",
    "\n",
    "\n",
    "def normalize_word(word):\n",
    "    word = word.lower().strip()\n",
    "    word = lemmatizer.lemmatize(word, pos=\"n\")\n",
    "    return word\n",
    "\n",
    "\n",
    "def is_valid_dictionary_word(word):\n",
    "    word = word.lower().strip()\n",
    "    if not word.replace(\"-\", \"\").isalpha():\n",
    "        return False\n",
    "    if word in ENGLISH_WORDS or wordnet.synsets(word):\n",
    "        return True\n",
    "    lemma = normalize_word(word)\n",
    "    return lemma in ENGLISH_WORDS or bool(wordnet.synsets(lemma))\n",
    "\n",
    "\n",
    "def is_scene_background_word(tag):\n",
    "    tokens = tag.strip().lower().split()\n",
    "    if len(tokens) != 1:   # fix bug bản cũ: KHÔNG xét head của tag nhiều từ (\"traffic light\" từng bị loại oan)\n",
    "        return False\n",
    "    return normalize_word(tokens[0]) in SCENE_BACKGROUND_STOPWORDS\n",
    "\n",
    "\n",
    "def caption_to_label(caption):\n",
    "    \"\"\"Trích cụm danh từ CUỐI CÙNG trước giới từ đầu tiên của caption làm nhãn flashcard.\n",
    "    \"a red vintage car parked on the street\" -> \"car\"; \"traffic light\" -> \"traffic light\".\"\"\"\n",
    "    toks = re.findall(r\"[a-z]+\", caption.lower())\n",
    "    cut = []\n",
    "    _CONJUNCTIONS = {\"and\", \"or\", \"an\", \"a\", \"the\"}   # SỬA: pos_tag đôi khi gán nhầm \"and\" là danh từ\n",
    "    for t in toks:                                     # -> nhãn rác kiểu \"and socket\"\n",
    "        if t in _PREPOSITIONS:\n",
    "            break\n",
    "        if t in _CONJUNCTIONS:\n",
    "            continue\n",
    "        cut.append(t)\n",
    "    if not cut:\n",
    "        return None\n",
    "    # SỬA: pos_tag hay gán nhầm danh từ trong cụm ngắn không ngữ cảnh thành động từ\n",
    "    # (\"microwave oven\" -> VB VBN -> mất trắng cả nhãn). Một token được coi là danh-từ-ứng-viên\n",
    "    # nếu POS là NN* HOẶC từ đó có nghĩa danh từ trong WordNet — trừ hư từ (a/the/and...).\n",
    "    _FUNC_WORDS = {\"a\", \"an\", \"the\", \"this\", \"that\", \"these\", \"those\", \"and\", \"or\",\n",
    "                   \"it\", \"its\", \"his\", \"her\", \"their\", \"my\", \"your\", \"our\", \"some\", \"any\"}\n",
    "    tagged = nltk.pos_tag(cut)\n",
    "    run, best = [], []\n",
    "    for w, p in tagged:\n",
    "        is_nounish = (w not in _FUNC_WORDS and len(w) > 1\n",
    "                      and (p.startswith(\"NN\") or bool(wordnet.synsets(w, pos=wordnet.NOUN))))\n",
    "        if is_nounish:\n",
    "            run.append(normalize_word(w))\n",
    "        else:\n",
    "            if run:\n",
    "                best = run\n",
    "            run = []\n",
    "    if run:\n",
    "        best = run\n",
    "    if not best:\n",
    "        return None\n",
    "    # Chỉ giữ cụm 2 danh từ nếu nó là từ ghép có thật trong WordNet (\"traffic light\", \"cell phone\");\n",
    "    # nếu không, lấy danh từ cuối cùng — tránh nhãn kiểu \"vintage car\" thay vì \"car\".\n",
    "    if len(best) >= 2 and wordnet.synsets(\"_\".join(best[-2:])):\n",
    "        return \" \".join(best[-2:])\n",
    "    return best[-1] or None\n",
    "\n",
    "\n",
    "# ====== Bộ lọc \"danh từ chỉ VẬT THỂ CỤ THỂ\" (đồng bộ với bản v8.4/8.5) ======\n",
    "# Caption của Florence-2 đôi khi ra danh từ trừu tượng (\"fun\", \"moment\", \"celebration\") — lọc bằng\n",
    "# WordNet: nghĩa phổ biến của từ phải là vật chụp được (lexname/chuỗi hypernym về physical_entity).\n",
    "ENABLE_CONCRETE_FILTER = True\n",
    "\n",
    "_PHYSICAL_ROOTS = {wordnet.synset(\"physical_entity.n.01\")}\n",
    "_CONCRETE_LEXNAMES = {\"noun.artifact\", \"noun.animal\", \"noun.food\", \"noun.person\",\n",
    "                      \"noun.plant\", \"noun.object\", \"noun.body\", \"noun.substance\"}\n",
    "_CONCRETE_WHITELIST = {\n",
    "    \"person\", \"bicycle\", \"car\", \"motorcycle\", \"airplane\", \"bus\", \"train\", \"truck\", \"boat\",\n",
    "    \"traffic light\", \"fire hydrant\", \"stop sign\", \"parking meter\", \"bench\", \"bird\", \"cat\", \"dog\",\n",
    "    \"horse\", \"sheep\", \"cow\", \"elephant\", \"bear\", \"zebra\", \"giraffe\", \"backpack\", \"umbrella\",\n",
    "    \"handbag\", \"tie\", \"suitcase\", \"frisbee\", \"skis\", \"snowboard\", \"sports ball\", \"kite\",\n",
    "    \"baseball bat\", \"baseball glove\", \"skateboard\", \"surfboard\", \"tennis racket\", \"bottle\",\n",
    "    \"wine glass\", \"cup\", \"fork\", \"knife\", \"spoon\", \"bowl\", \"banana\", \"apple\", \"sandwich\", \"orange\",\n",
    "    \"broccoli\", \"carrot\", \"hot dog\", \"pizza\", \"donut\", \"cake\", \"chair\", \"couch\", \"potted plant\",\n",
    "    \"bed\", \"dining table\", \"toilet\", \"tv\", \"laptop\", \"mouse\", \"remote\", \"keyboard\", \"cell phone\",\n",
    "    \"microwave\", \"oven\", \"toaster\", \"sink\", \"refrigerator\", \"book\", \"clock\", \"vase\", \"scissors\",\n",
    "    \"teddy bear\", \"hair drier\", \"toothbrush\", \"ring\", \"sign\", \"kite\",\n",
    "}\n",
    "\n",
    "\n",
    "def _sense_is_concrete(syn, max_up=20):\n",
    "    if syn.lexname() in _CONCRETE_LEXNAMES:\n",
    "        return True\n",
    "    frontier = {syn}\n",
    "    for _ in range(max_up):\n",
    "        if frontier & _PHYSICAL_ROOTS:\n",
    "            return True\n",
    "        nxt = set()\n",
    "        for s in frontier:\n",
    "            nxt.update(s.hypernyms())\n",
    "        if not nxt:\n",
    "            return False\n",
    "        frontier = nxt\n",
    "    return False\n",
    "\n",
    "\n",
    "def is_concrete_object_word(tag):\n",
    "    t = tag.strip().lower()\n",
    "    if t in _CONCRETE_WHITELIST:\n",
    "        return True\n",
    "    key = t.replace(\" \", \"_\")\n",
    "    syns = wordnet.synsets(key, pos=wordnet.NOUN)\n",
    "    if not syns and \" \" in t:\n",
    "        syns = wordnet.synsets(t.split()[-1], pos=wordnet.NOUN)\n",
    "    if not syns:\n",
    "        return False if wordnet.synsets(key) else None\n",
    "    if _sense_is_concrete(syns[0]):\n",
    "        return True\n",
    "    return sum(_sense_is_concrete(s) for s in syns[1:3]) >= 2\n",
    "\n",
    "\n",
    "def check_synonyms(word1, word2):\n",
    "    w1, w2 = word1.lower().strip(), word2.lower().strip()\n",
    "    if w1 == w2:\n",
    "        return True\n",
    "    syns1 = set()\n",
    "    for syn in wordnet.synsets(w1.replace(\" \", \"_\")):\n",
    "        for lemma in syn.lemmas():\n",
    "            syns1.add(lemma.name().lower().replace(\"_\", \" \"))\n",
    "    return w2 in syns1\n",
    "\n",
    "\n",
    "LABEL_ALIASES = {\n",
    "    \"person\": {\"man\", \"woman\", \"boy\", \"girl\", \"child\", \"kid\", \"lady\", \"guy\", \"people\",\n",
    "               \"player\", \"pedestrian\", \"rider\", \"baby\", \"human\"},\n",
    "    \"tv\": {\"television\", \"monitor\", \"screen\", \"tv set\"},\n",
    "    \"couch\": {\"sofa\", \"settee\"},\n",
    "    \"motorcycle\": {\"motorbike\"},\n",
    "    \"bicycle\": {\"bike\", \"cycle\"},\n",
    "    \"cell phone\": {\"phone\", \"mobile phone\", \"smartphone\", \"telephone\"},\n",
    "    \"sports ball\": {\"ball\", \"soccer ball\", \"basketball\", \"baseball\", \"tennis ball\", \"football\", \"volleyball\"},\n",
    "    \"potted plant\": {\"plant\", \"houseplant\", \"flowerpot\", \"pot plant\"},\n",
    "    \"dining table\": {\"table\", \"desk\"},\n",
    "    \"hair drier\": {\"hair dryer\", \"dryer\", \"blow dryer\"},\n",
    "    \"airplane\": {\"plane\", \"aircraft\", \"jet\"},\n",
    "    \"boat\": {\"ship\", \"sailboat\", \"canoe\", \"kayak\"},\n",
    "    \"car\": {\"automobile\", \"suv\", \"sedan\", \"taxi\", \"van\"},\n",
    "    \"remote\": {\"remote control\", \"controller\"},\n",
    "    \"handbag\": {\"purse\", \"bag\"},\n",
    "    \"backpack\": {\"rucksack\", \"knapsack\"},\n",
    "    \"wine glass\": {\"wineglass\", \"glass\"},\n",
    "    \"traffic light\": {\"stoplight\", \"traffic signal\"},\n",
    "}\n",
    "\n",
    "# SỬA — từ phân tích 96 lượt từ sót trên Internet-50: các lớp phạm trù/bộ phận của Open Images\n",
    "# mà Florence gọi bằng tên khác. Thiếu alias thì detection đúng vẫn bị chấm FP + FN kép.\n",
    "LABEL_ALIASES.update({\n",
    "    \"tire\": {\"wheel\", \"tyre\"},\n",
    "    \"auto part\": {\"wheel\", \"tire\", \"bumper\", \"headlight\", \"windshield\", \"mirror\"},\n",
    "    \"land vehicle\": {\"car\", \"truck\", \"bus\", \"van\", \"motorcycle\", \"bicycle\", \"vehicle\"},\n",
    "    \"vehicle registration plate\": {\"license plate\", \"number plate\", \"plate\"},\n",
    "    \"human head\": {\"head\", \"face\", \"human face\"},\n",
    "    \"human body\": {\"body\", \"person\", \"torso\"},\n",
    "    \"sports equipment\": {\"ball\", \"racket\", \"bat\", \"glove\", \"helmet\", \"ski\"},\n",
    "    \"clothing\": {\"shirt\", \"jacket\", \"dress\", \"coat\", \"t-shirt\", \"pants\", \"trousers\",\n",
    "                 \"trouser\", \"jeans\", \"uniform\", \"jersey\", \"shorts\"},\n",
    "    \"footwear\": {\"shoe\", \"sneaker\", \"boot\", \"sandal\", \"cleat\"},\n",
    "})\n",
    "\n",
    "\n",
    "def _hypernym_match(det_label, gt_label, max_up=6):\n",
    "    # SỬA: 4 -> 6 bậc. Đo từ log Internet-50: GT \"mammal\" sót 5 lượt dù ảnh có horse/dog —\n",
    "    # chuỗi horse -> equine -> odd-toed ungulate -> ungulate -> placental -> mammal cần 5 bậc.\n",
    "    det_syns = wordnet.synsets(det_label.replace(\" \", \"_\"), pos=wordnet.NOUN)\n",
    "    gt_syns = set(wordnet.synsets(gt_label.replace(\" \", \"_\"), pos=wordnet.NOUN))\n",
    "    if not det_syns or not gt_syns:\n",
    "        return False\n",
    "    frontier = set(det_syns)\n",
    "    for _ in range(max_up):\n",
    "        nxt = set()\n",
    "        for s in frontier:\n",
    "            # CHỈ hypernyms thường, KHÔNG instance_hypernyms: nghĩa tên-riêng trong WordNet\n",
    "            # (vd \"Tree\" = diễn viên Herbert Beerbohm Tree -> actor -> person) gây khớp nhầm\n",
    "            # kiểu \"tree\" ~ \"person\".\n",
    "            nxt.update(s.hypernyms())\n",
    "        if nxt & gt_syns:\n",
    "            return True\n",
    "        frontier = nxt\n",
    "        if not frontier:\n",
    "            break\n",
    "    return False\n",
    "\n",
    "\n",
    "def labels_match(det_label, gt_label):\n",
    "    d, g = det_label.lower().strip(), gt_label.lower().strip()\n",
    "    if check_synonyms(d, g):\n",
    "        return True\n",
    "    if g in LABEL_ALIASES and d in LABEL_ALIASES[g]:\n",
    "        return True\n",
    "    if d in LABEL_ALIASES and g in LABEL_ALIASES[d]:\n",
    "        return True\n",
    "    return _hypernym_match(d, g)\n",
    "\n",
    "\n",
    "def map_label_to_vocab(label, vocab):\n",
    "    l = label.lower().strip()\n",
    "    if l in vocab:\n",
    "        return l\n",
    "    for v in vocab:\n",
    "        if labels_match(l, v):\n",
    "            return v\n",
    "    return None\n",
    "\n",
    "\n",
    "def compute_iou(box1, box2):\n",
    "    x1 = max(box1[0], box2[0]); y1 = max(box1[1], box2[1])\n",
    "    x2 = min(box1[2], box2[2]); y2 = min(box1[3], box2[3])\n",
    "    inter = max(0, x2 - x1) * max(0, y2 - y1)\n",
    "    area1 = (box1[2] - box1[0]) * (box1[3] - box1[1])\n",
    "    area2 = (box2[2] - box2[0]) * (box2[3] - box2[1])\n",
    "    union = area1 + area2 - inter\n",
    "    return inter / union if union > 0 else 0.0\n"
   ]
  },
