    "\n",
    "def _clean_label(raw_label, from_caption=False):\n",
    "    \"\"\"Chuẩn hoá nhãn thô của Florence-2 -> nhãn flashcard, None nếu bị loại.\"\"\"\n",
    "    if not raw_label:\n",
    "        return None\n",
    "    # SỬA: nhãn <OD> nhiều từ giờ CŨNG đi qua caption_to_label (trích cụm danh từ liên tiếp +\n",
    "    # kiểm tra từ ghép WordNet). Bản cũ lấy thô \"2 token cuối\" nên \"plug and socket\" ra \"and socket\".\n",
    "    label = caption_to_label(raw_label)\n",
    "    if not label:\n",
    "        return None\n",
    "    if is_scene_background_word(label):\n",
    "        return None\n",
    "    if label in GENERIC_LABEL_BLACKLIST:\n",
    "        return None   # quá chung chung, không có giá trị flashcard\n",
    "    if ENABLE_CONCRETE_FILTER and is_concrete_object_word(label) is False:\n",
    "        return None   # danh từ trừu tượng/động từ -> không phải vật chụp được\n",
    "    head = label.split()[-1]\n",
    "    # SỬA MỚI: nhãn trích từ CAPTION phải qua từ điển kể cả ở chế độ mềm — caption của Florence-2\n",
    "    # đôi khi sinh TÊN RIÊNG (\"kennedy\", \"heston\", \"john wayne\") hoặc typo khi generate\n",
    "    # (\"taillilight\") làm flashcard rác. Chế độ mềm chỉ dành cho nhãn <OD>/grounding.\n",
    "    if from_caption and not is_valid_dictionary_word(head):\n",
    "        return None\n",
    "    if STRICT_DICTIONARY_FILTER and not is_valid_dictionary_word(head):\n",
    "        return None\n",
    "    return label\n",
    "\n",
    "\n",
    "def florence_detect(image, extra_tags=None, use_dense_caption=True):\n",
    "    \"\"\"Trả về list[{\"label\", \"score\", \"box\", \"source\"}] — box pixel [x1,y1,x2,y2].\"\"\"\n",
    "    detections = []\n",
    "\n",
    "    # ---- 1. <OD> ----\n",
    "    od = run_florence(image, \"<OD>\")\n",
    "    for box, raw in zip(od.get(\"bboxes\", []), od.get(\"labels\", [])):\n",
    "        label = _clean_label(raw, from_caption=False)\n",
    "        if label:\n",
    "            detections.append({\"label\": label, \"score\": PSEUDO_SCORE[\"od\"],\n",
    "                               \"box\": [float(v) for v in box], \"source\": \"od\"})\n",
    "\n",
    "    # ---- 1b. <OD> trên 4 ô chồng lấn (xem chú thích ENABLE_TILED_OD) ----\n",
    "    if ENABLE_TILED_OD:\n",
    "        W, H = image.width, image.height\n",
    "        tiles = [(0, 0, int(0.6 * W), int(0.6 * H)), (int(0.4 * W), 0, W, int(0.6 * H)),\n",
    "                 (0, int(0.4 * H), int(0.6 * W), H), (int(0.4 * W), int(0.4 * H), W, H)]\n",
    "        margin = 8\n",
    "        for (tx1, ty1, tx2, ty2) in tiles:\n",
    "            od_t = run_florence(image.crop((tx1, ty1, tx2, ty2)), \"<OD>\")\n",
    "            for box, raw in zip(od_t.get(\"bboxes\", []), od_t.get(\"labels\", [])):\n",
    "                x1, y1, x2, y2 = (float(v) for v in box)\n",
    "                tw, th = tx2 - tx1, ty2 - ty1\n",
    "                # bỏ box chạm mép TRONG của ô (vật bị ô cắt cụt) — mép trùng biên ảnh thì cho phép\n",
    "                if ((x1 < margin and tx1 > 0) or (y1 < margin and ty1 > 0)\n",
    "                        or (x2 > tw - margin and tx2 < W) or (y2 > th - margin and ty2 < H)):\n",
    "                    continue\n",
    "                label = _clean_label(raw, from_caption=False)\n",
    "                if label:\n",
    "                    detections.append({\"label\": label, \"score\": PSEUDO_SCORE[\"od\"] - 0.02,\n",
    "                                       \"box\": [x1 + tx1, y1 + ty1, x2 + tx1, y2 + ty1],\n",
    "                                       \"source\": \"od_tile\"})\n",
    "\n",
    "    # ---- 1c. Self-grounding: caption chi tiết -> ground chính caption đó ----\n",
    "    if ENABLE_SELF_GROUNDING:\n",
    "        try:\n",
    "            detailed_cap = run_florence(image, \"<MORE_DETAILED_CAPTION>\")\n",
    "            if isinstance(detailed_cap, str) and detailed_cap.strip():\n",
    "                gr_self = run_florence(image, \"<CAPTION_TO_PHRASE_GROUNDING>\",\n",
    "                                       text_input=detailed_cap.strip())\n",
    "                for box, phrase in zip(gr_self.get(\"bboxes\", []), gr_self.get(\"labels\", [])):\n",
    "                    label = _clean_label(phrase, from_caption=True)\n",
    "                    if label:\n",
    "                        detections.append({\"label\": label, \"score\": PSEUDO_SCORE[\"self\"],\n",
    "                                           \"box\": [float(v) for v in box], \"source\": \"self\"})\n",
    "        except Exception as e:\n",
    "            print(f\"   (Self-grounding lỗi, bỏ qua: {e})\")\n",
    "\n",
    "    # ---- 2. <DENSE_REGION_CAPTION> ----\n",
    "    if use_dense_caption:\n",
    "        dense = run_florence(image, \"<DENSE_REGION_CAPTION>\")\n",
    "        for box, cap in zip(dense.get(\"bboxes\", []), dense.get(\"labels\", [])):\n",
    "            label = _clean_label(cap, from_caption=True)\n",
    "            if label:\n",
    "                detections.append({\"label\": label, \"score\": PSEUDO_SCORE[\"dense\"],\n",
    "                                   \"box\": [float(v) for v in box], \"source\": \"dense\"})\n",
    "\n",
    "    # ---- 3. Grounding các tag thủ công (thay extra_tags cũ) ----\n",
    "    if extra_tags:\n",
    "        text = \". \".join(t.strip().lower() for t in extra_tags if t.strip()) + \".\"\n",
    "        gr = run_florence(image, \"<CAPTION_TO_PHRASE_GROUNDING>\", text_input=text)\n",
    "        for box, raw in zip(gr.get(\"bboxes\", []), gr.get(\"labels\", [])):\n",
    "            label = (raw or \"\").strip().lower()\n",
    "            if label:\n",
    "                detections.append({\"label\": label, \"score\": PSEUDO_SCORE[\"grounding\"],\n",
    "                                   \"box\": [float(v) for v in box], \"source\": \"grounding\"})\n",
    "\n",
    "    # ---- 4. Từ vựng nền (tuỳ chọn — xem chú thích ở đầu cell) ----\n",
    "    if ENABLE_BASE_VOCAB or ENABLE_TARGETED_GROUNDING:\n",
    "        img_area = float(image.width * image.height)\n",
    "        existing = [d[\"label\"] for d in detections]\n",
    "        if ENABLE_BASE_VOCAB:\n",
    "            query_vocab = list(BASE_VOCAB) + (EXTRA_HOUSEHOLD_VOCAB if ENABLE_EXTRA_VOCAB else [])\n",
    "        else:\n",
    "            query_vocab = list(TARGETED_GROUNDING_WORDS)\n",
    "        todo = [w for w in query_vocab\n",
    "                if not any(labels_match(w, e) or labels_match(e, w) for e in existing)]\n",
    "        for k in range(0, len(todo), 12):\n",
    "            chunk = todo[k:k + 12]\n",
    "            text = \". \".join(chunk) + \".\"\n",
    "            gr = run_florence(image, \"<CAPTION_TO_PHRASE_GROUNDING>\", text_input=text)\n",
    "            for box, raw in zip(gr.get(\"bboxes\", []), gr.get(\"labels\", [])):\n",
    "                label = (raw or \"\").strip().lower()\n",
    "                if not label or label not in chunk:\n",
    "                    continue   # chỉ nhận đúng từ trong chunk, bỏ cụm ghép lạ\n",
    "                x1, y1, x2, y2 = (float(v) for v in box)\n",
    "                if (x2 - x1) * (y2 - y1) > 0.85 * img_area:\n",
    "                    continue   # box trùm gần hết ảnh = dấu hiệu ảo giác của grounding\n",
    "                detections.append({\"label\": label, \"score\": PSEUDO_SCORE[\"base\"],\n",
    "                                   \"box\": [x1, y1, x2, y2], \"source\": \"base\"})\n",
    "\n",
    "    return detections\n",
    "\n",
    "\n",
    "def dedup_detections(detections, same_label_iou=0.5, related_label_iou=0.7):\n",
    "    \"\"\"NMS đơn giản 2 mức: cùng nhãn (IoU>=0.5) và nhãn \"liên quan\" theo labels_match (IoU>=0.7).\n",
    "    Ưu tiên giữ nguồn điểm cao hơn (<OD> > grounding > dense).\"\"\"\n",
    "    survivors = sorted(detections, key=lambda d: -d[\"score\"])\n",
    "    kept, suppressed = [], [False] * len(survivors)\n",
    "    for i in range(len(survivors)):\n",
    "        if suppressed[i]:\n",
    "            continue\n",
    "        kept.append(survivors[i])\n",
    "        for j in range(i + 1, len(survivors)):\n",
    "            if suppressed[j]:\n",
    "                continue\n",
    "            iou = compute_iou(survivors[i][\"box\"], survivors[j][\"box\"])\n",
    "            same = survivors[i][\"label\"] == survivors[j][\"label\"]\n",
    "            related = same or labels_match(survivors[j][\"label\"], survivors[i][\"label\"]) \\\n",
    "                           or labels_match(survivors[i][\"label\"], survivors[j][\"label\"])\n",
    "            if (same and iou >= same_label_iou) or (related and iou >= related_label_iou):\n",
    "                suppressed[j] = True\n",
    "    return kept\n"
   ]
