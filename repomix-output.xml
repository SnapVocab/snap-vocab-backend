    "                                  # giữ sàn thấp; sàn thấp từng để lọt skis/envelope/key trong ảnh bếp.\n",
    "# MỚI (nhắm word-precision 0.802 -> 0.85+): CLIP xác thực MỌI box (không chỉ nguồn base).\n",
    "# Ngưỡng sàn riêng, mềm hơn base (od/dense là đề xuất thật của model, ít ảo giác hơn grounding).\n",
    "ENABLE_CLIP_VERIFY_ALL = False\n",
    "CLIP_VERIFY_ALL_THRESHOLD = 0.20\n",
    "CLIP_RANK_MARGIN = 0.02           # nhãn của crop phải khớp KHÔNG KÉM QUÁ 0.02 so với từ khớp nhất\n",
    "                                  # (fork/spoon/knife bám nhau ~0.01 vẫn sống; siết cửa cho ảo giác\n",
    "                                  # \"na ná\": tennis racket từng thua handbag 0.043 mà vẫn lọt ở 0.03)\n",
    "\n",
    "\n",
    "def _lazy_load_clip():\n",
    "    \"\"\"Tải CLIP khi cần (nếu chưa bật ENABLE_CLIP_SCORING ở Bước 2).\"\"\"\n",
    "    global clip_model, clip_processor\n",
    "    if \"clip_model\" in globals():\n",
    "        return\n",
    "    from transformers import CLIPModel, CLIPProcessor\n",
    "    print(\"   (Tải CLIP ~600MB để xác thực từ vựng nền — chỉ lần đầu...)\")\n",
    "    clip_model = CLIPModel.from_pretrained(\"openai/clip-vit-base-patch32\").to(device).eval()\n",
    "    clip_processor = CLIPProcessor.from_pretrained(\"openai/clip-vit-base-patch32\")\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def clip_verify_detections(raw_image, dets, threshold, margin=None):\n",
    "    \"\"\"SỬA v2 — kiểm tra theo THỨ HẠNG thay vì chỉ ngưỡng tuyệt đối. Ngưỡng tuyệt đối để lọt\n",
    "    các ảo giác \"sát ngưỡng\" (frisbee/snowboard trong bếp đạt 0.22-0.24). Giờ: crop phải khớp\n",
    "    với CHÍNH TỪ CỦA NÓ gần bằng từ khớp nhất — crop \"frisbee\" thực chất là cái bát sẽ khớp\n",
    "    \"bowl\" mạnh hơn hẳn (chênh ~0.07) -> loại; fork/spoon/knife bám nhau ~0.01 -> sống.\n",
    "    Điều kiện giữ: sim >= ngưỡng sàn VÀ sim >= (điểm cao nhất của crop - CLIP_RANK_MARGIN).\"\"\"\n",
    "    if not dets:\n",
    "        return [], []\n",
    "    if margin is None:\n",
    "        margin = CLIP_RANK_MARGIN\n",
    "    _lazy_load_clip()\n",
    "    crops = []\n",
    "    for d in dets:\n",
    "        x1, y1, x2, y2 = (int(v) for v in d[\"box\"])\n",
    "        crops.append(raw_image.crop((max(0, x1), max(0, y1), max(x1 + 1, x2), max(y1 + 1, y2))))\n",
    "\n",
    "    # tập ứng viên = từ vựng nền + nhãn của chính các det (khử trùng, giữ thứ tự)\n",
    "    cand_vocab = list(BASE_VOCAB) + (EXTRA_HOUSEHOLD_VOCAB if ENABLE_EXTRA_VOCAB else [])\n",
    "    candidates = list(dict.fromkeys(cand_vocab + [d[\"label\"] for d in dets]))\n",
    "    text_inputs = clip_processor(text=[f\"a photo of a {c}\" for c in candidates],\n",
    "                                 return_tensors=\"pt\", padding=True).to(device)\n",
    "    te = clip_model.get_text_features(**text_inputs)\n",
    "    te = te / te.norm(dim=-1, keepdim=True)\n",
    "    img_inputs = clip_processor(images=crops, return_tensors=\"pt\").to(device)\n",
    "    ie = clip_model.get_image_features(**img_inputs)\n",
    "    ie = ie / ie.norm(dim=-1, keepdim=True)\n",
    "    sims = ie @ te.T   # [số crop, số ứng viên]\n",
    "\n",
    "    kept, dropped = [], []\n",
    "    for i, d in enumerate(dets):\n",
    "        own = candidates.index(d[\"label\"])\n",
    "        s = float(sims[i, own])\n",
    "        best = float(sims[i].max())\n",
    "        if s >= threshold and s >= best - margin:\n",
    "            kept.append(d)\n",
    "        else:\n",
    "            best_lbl = candidates[int(sims[i].argmax().item())]\n",
    "            dropped.append((d[\"label\"], round(s, 3), f\"thua '{best_lbl}' {round(best - s, 3)}\"))\n",
    "    return kept, dropped\n",
    "CLIP_REJECT_THRESHOLD = 0.20\n",
    "\n",
    "\n",
    "def _sam_stability_score(mask_logits, threshold=0.0, offset=1.0):\n",
    "    inter = np.count_nonzero(mask_logits > (threshold + offset))\n",
    "    union = np.count_nonzero(mask_logits > (threshold - offset))\n",
    "    return float(inter) / float(union) if union > 0 else 0.0\n",
    "\n",
    "\n",
    "def _sam_clean_mask(binary_mask):\n",
    "    mask_u8 = (binary_mask.astype(np.uint8)) * 255\n",
    "    kernel = np.ones((3, 3), np.uint8)\n",
    "    mask_u8 = cv2.morphologyEx(mask_u8, cv2.MORPH_CLOSE, kernel, iterations=1)\n",
    "    mask_u8 = cv2.morphologyEx(mask_u8, cv2.MORPH_OPEN, kernel, iterations=1)\n",
    "    n_labels, labels, stats, _ = cv2.connectedComponentsWithStats(mask_u8, connectivity=8)\n",
    "    if n_labels <= 1:\n",
    "        return binary_mask\n",
    "    largest = 1 + int(np.argmax(stats[1:, cv2.CC_STAT_AREA]))\n",
    "    return labels == largest\n",
    "\n",
    "\n",
    "def segment_one_box(box_np):\n",
    "    x1, y1, x2, y2 = box_np\n",
    "    point_coords = np.array([[(x1 + x2) / 2.0, (y1 + y2) / 2.0]])\n",
    "    point_labels = np.array([1])\n",
    "    raw_masks, iou_preds, _ = sam_predictor.predict(\n",
    "        box=box_np, point_coords=point_coords, point_labels=point_labels,\n",
    "        multimask_output=True, return_logits=True,\n",
    "    )\n",
    "    stability = np.array([_sam_stability_score(m) for m in raw_masks])\n",
    "    best = int(np.argmax(SAM_IOU_WEIGHT * iou_preds + SAM_STABILITY_WEIGHT * stability))\n",
    "    mask = raw_masks[best] > sam_predictor.model.mask_threshold\n",
    "    return _sam_clean_mask(mask), float(iou_preds[best]), float(stability[best])\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def clip_score_crops(crop_images, labels):\n",
    "    inputs = clip_processor(text=[f\"a photo of a {l}\" for l in labels], images=crop_images,\n",
    "                            return_tensors=\"pt\", padding=True).to(device)\n",
    "    out = clip_model(**inputs)\n",
    "    img_e = out.image_embeds / out.image_embeds.norm(dim=-1, keepdim=True)\n",
    "    txt_e = out.text_embeds / out.text_embeds.norm(dim=-1, keepdim=True)\n",
    "    return (img_e * txt_e).sum(dim=-1).cpu().tolist()\n",
    "\n",
    "\n",
    "PIPELINE_VERSION = \"F2-v13 (word-level + clip-verify-all, 2026-07-26)\"   # NÂNG SỐ MỖI LẦN NHẬN FILE MỚI\n",
    "\n",
    "\n",
    "def process_and_crop_flashcards(image_path, output_dir=\"flashcards\", save_metadata=True,\n",
    "                                 extra_tags=None, use_dense_caption=True, show_plot=True):\n",
    "    print(f\"[{PIPELINE_VERSION}]\")   # dấu phiên bản — đối chiếu log để biết chắc đang chạy bản nào\n",
    "    raw_image = Image.open(image_path).convert(\"RGB\")\n",
    "    image_np = np.array(raw_image)\n",
    "    H, W = image_np.shape[:2]\n",
    "\n",
    "    # ---------- 1. Florence-2: đề xuất box + nhãn mở ----------\n",
    "    print(\"1. Florence-2 (<OD> + dense region caption)...\")\n",
    "    detections = florence_detect(raw_image, extra_tags=extra_tags, use_dense_caption=use_dense_caption)\n",
    "    n_raw = len(detections)\n",
    "\n",
    "    # ---------- 2. Giao từ vựng khi eval trên bộ nhãn đóng (COCO) ----------\n",
    "    if EVAL_RESTRICT_VOCAB:\n",
    "        mapped = []\n",
    "        for d in detections:\n",
    "            mv = map_label_to_vocab(d[\"label\"], EVAL_RESTRICT_VOCAB)\n",
    "            if mv:\n",
    "                mapped.append({**d, \"label\": mv})\n",
    "        print(f\"-> [EVAL] Giao với từ vựng đánh giá: giữ {len(mapped)}/{len(detections)} detection.\")\n",
    "        detections = mapped\n",
    "\n",
    "    # ---------- 3. Khử trùng lặp giữa <OD> / dense / grounding ----------\n",
    "    detections = dedup_detections(detections)\n",
    "    print(f\"-> {n_raw} box thô -> {len(detections)} sau dedup: {[d['label'] for d in detections]}\")\n",
    "\n",
    "    # CLIP gác cửa cho từ vựng nền (bắt buộc khi ENABLE_BASE_VOCAB — xem clip_verify_detections)\n",
    "    base_dets = [d for d in detections if d.get(\"source\") == \"base\"]\n",
    "    if base_dets:\n",
    "        others = [d for d in detections if d.get(\"source\") != \"base\"]\n",
    "        # SỬA MỚI: box \"base\" đè lên vật MÀ <OD> ĐÃ NHẬN DIỆN với nhãn KHÁC -> tin <OD>, bỏ base.\n",
    "        # Ảo giác grounding hay \"mượn xác\" vật thật: box \"skis\" đè lên thìa gỗ mà OD gọi là spoon —\n",
    "        # biên độ CLIP không cứu nổi vì thìa gỗ dài trông giống skis thật.\n",
    "        # LỊCH SỬ: từng có luật \"phủ quyết\" — bỏ box base đè lên vật nguồn khác (rồi thu hẹp còn\n",
    "        # od/od_tile). Đo thật 2 vòng cho thấy luật này KHÔNG phân biệt nổi \"đè vì ảo giác\" với\n",
    "        # \"đè vì vật nằm TRÊN vật khác\" (box turkey đè box toy = cái ghế con gà tây ngồi lên ->\n",
    "        # giết oan turkey, mất 41 -> 24 thẻ). Nay CLIP biên độ đã có bộ ứng viên giàu (log cho\n",
    "        # thấy skis/snowboard thua \"ham\"/\"spatula\" bằng biên độ) nên luật này THỪA -> tắt mặc\n",
    "        # định, giữ code làm tư liệu ablation.\n",
    "        ENABLE_BASE_OVERLAP_VETO = False\n",
    "        if ENABLE_BASE_OVERLAP_VETO:\n",
    "            _trusted = [o for o in others if o.get(\"source\") in (\"od\", \"od_tile\")]\n",
    "\n",
    "            def _overlaps_known(bd):\n",
    "                for o in _trusted:\n",
    "                    if compute_iou(bd[\"box\"], o[\"box\"]) > 0.6 and not (\n",
    "                            labels_match(bd[\"label\"], o[\"label\"]) or labels_match(o[\"label\"], bd[\"label\"])):\n",
    "                        return True\n",
    "                return False\n",
    "            n0 = len(base_dets)\n",
    "            base_dets = [d for d in base_dets if not _overlaps_known(d)]\n",
    "            if n0 - len(base_dets):\n",
    "                print(f\"-> [BASE] Bỏ {n0 - len(base_dets)} box từ vựng nền đè lên vật <OD> đã nhận diện.\")\n",
    "        kept, dropped = clip_verify_detections(raw_image, base_dets, CLIP_BASE_THRESHOLD)\n",
    "        if dropped:\n",
    "            print(f\"-> [CLIP] Loại {len(dropped)} box từ vựng nền không khớp ảnh: {dropped}\")\n",
    "        detections = others + kept\n",
    "\n",
    "    # CLIP xác thực toàn bộ (tuỳ chọn — ablation 4): loại box mà crop không khớp nhãn của chính nó\n",
    "    if ENABLE_CLIP_VERIFY_ALL and detections:\n",
    "        kept_all, dropped_all = clip_verify_detections(raw_image, detections, CLIP_VERIFY_ALL_THRESHOLD)\n",
    "        if dropped_all:\n",
    "            print(f\"-> [CLIP-ALL] Loại {len(dropped_all)}/{len(detections)} box: {dropped_all[:10]}\"\n",
    "                  + (\" ...\" if len(dropped_all) > 10 else \"\"))\n",
    "        detections = kept_all\n",
    "\n",
    "    # Chế độ flashcard: mỗi label chỉ giữ box điểm cao nhất (xem chú thích MAX_CARDS_PER_LABEL)\n",
    "    if MAX_CARDS_PER_LABEL:\n",
    "        by_label = {}\n",
    "        for d in sorted(detections, key=lambda x: -x[\"score\"]):\n",
    "            by_label.setdefault(d[\"label\"], []).append(d)\n",
    "        detections = [d for lst in by_label.values() for d in lst[:MAX_CARDS_PER_LABEL]]\n",
    "        print(f\"-> [FLASHCARD] Giữ tối đa {MAX_CARDS_PER_LABEL} thẻ/label: còn {len(detections)} thẻ.\")\n",
    "\n",
    "    # ---------- 4. SAM xác thực + cắt flashcard ----------\n",
    "    print(\"2. SAM xác thực + cắt nền...\")\n",
    "    sam_predictor.set_image(image_np)\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "    if show_plot:\n",
    "        fig, ax = plt.subplots(1, figsize=(10, 10))\n",
    "        ax.imshow(raw_image)\n",
    "    colors = cm.rainbow(np.linspace(0, 1, max(1, len(detections))))\n",
    "\n",
    "    metadata, n_tiny_removed = [], 0\n",
    "    min_mask_px = 50 if EVAL_RELAX_SMALL_FILTERS else SAM_MIN_MASK_AREA_PX\n",
    "\n",
    "    for i, (d, color) in enumerate(zip(detections, colors)):\n",
    "        # Cổng từ điển cuối: mọi từ lên flashcard phải có trong từ điển tiếng Anh\n",
    "        if REQUIRE_DICTIONARY_LABELS and not is_valid_dictionary_word(d[\"label\"].split()[-1]):\n",
    "            continue\n",
    "        x1, y1, x2, y2 = d[\"box\"]\n",
    "        mask, iou_pred, stab = segment_one_box(np.array(d[\"box\"]))\n",
    "        mask_area = int(mask.sum())\n",
    "        box_area = max(1.0, (x2 - x1) * (y2 - y1))\n",
    "        if mask_area < min_mask_px or (mask_area / box_area) < SAM_MIN_MASK_BOX_RATIO:\n",
    "            n_tiny_removed += 1\n",
    "            continue\n",
    "\n",
    "        if show_plot:\n",
    "            ax.add_patch(patches.Rectangle((x1, y1), x2 - x1, y2 - y1, linewidth=2,\n",
    "                                           edgecolor=color, facecolor=\"none\"))\n",
    "            ax.text(x1, max(0, y1 - 5), f\"{d['label']} [{d['source']}]\", color=color,\n",
    "                    fontsize=10, weight=\"bold\")\n",
    "\n",
    "        ys, xs = np.where(mask)\n",
    "        mx1 = max(0, int(xs.min()) - SAM_CROP_PADDING); my1 = max(0, int(ys.min()) - SAM_CROP_PADDING)\n",
    "        mx2 = min(W, int(xs.max()) + 1 + SAM_CROP_PADDING); my2 = min(H, int(ys.max()) + 1 + SAM_CROP_PADDING)\n",
    "        if mx2 <= mx1 or my2 <= my1:\n",
    "            n_tiny_removed += 1\n",
    "            continue\n",
    "\n",
    "        rgba = np.dstack([image_np, (mask.astype(np.uint8) * 255)])\n",
    "        out_path = os.path.join(output_dir, f\"{d['label'].replace(' ', '_')}_{i}.png\")\n",
    "        Image.fromarray(rgba[my1:my2, mx1:mx2], mode=\"RGBA\").save(out_path)\n",
    "        metadata.append({\"label\": d[\"label\"], \"score\": d[\"score\"], \"box\": d[\"box\"],\n",
    "                         \"source\": d[\"source\"], \"mask_area_px\": mask_area,\n",
    "                         \"sam_iou_pred\": round(iou_pred, 3), \"sam_stability\": round(stab, 3),\n",
    "                         \"file\": out_path})\n",
    "\n",
    "    if show_plot:\n",
    "        ax.axis(\"off\"); plt.show()\n",
    "\n",
    "    # ---------- 5. CLIP chấm điểm thật (tuỳ chọn — Florence-2 không có confidence) ----------\n",
    "    if ENABLE_CLIP_SCORING and metadata:\n",
    "        print(\"3. CLIP chấm điểm crop <-> nhãn...\")\n",
    "        crops = [Image.open(m[\"file\"]).convert(\"RGB\") for m in metadata]\n",
    "        sims = clip_score_crops(crops, [m[\"label\"] for m in metadata])\n",
    "        kept = []\n",
    "        for m, s in zip(metadata, sims):\n",
    "            if s >= CLIP_REJECT_THRESHOLD:\n",
    "                kept.append({**m, \"clip_score\": round(s, 4), \"score\": round(0.5 * m[\"score\"] + 0.5 * s, 4)})\n",
    "            elif os.path.exists(m[\"file\"]):\n",
    "                os.remove(m[\"file\"])\n",
    "        print(f\"-> CLIP giữ {len(kept)}/{len(metadata)}.\")\n",
    "        metadata = sorted(kept, key=lambda m: -m[\"score\"])\n",
    "\n",
    "    if save_metadata:\n",
    "        with open(os.path.join(output_dir, \"metadata.json\"), \"w\", encoding=\"utf-8\") as f:\n",
    "            json.dump(metadata, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "    final_detections = [{\"label\": m[\"label\"], \"score\": m[\"score\"], \"box\": m[\"box\"]} for m in metadata]\n",
    "    print(f\"\\n===== BÁO CÁO =====\")\n",
    "    print(f\"Box thô Florence-2:            {n_raw}\")\n",
    "    print(f\"Sau dedup:                     {len(detections)}\")\n",
    "    print(f\"Bị loại do SAM (mask quá nhỏ): {n_tiny_removed}\")\n",
    "    print(f\"Flashcard cuối cùng:           {len(final_detections)} -> thư mục '{output_dir}'\")\n",
    "    return final_detections, [d[\"label\"] for d in detections], [d[\"label\"] for d in detections]\n"
