DB_URL=jdbc:mariadb://example.com:3306/snapvocab
DB_USERNAME=db_user_here
DB_PASSWORD=db_password_here

REDIS_HOST=example.com
REDIS_PORT=redis_port
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DATABASE=0

MAIL_USERNAME=gmail_user
MAIL_PASSWORD=app_password

JWT_SECRET=secret

MINIO_ENDPOINT=https://example.com
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET=minio_bucket

AI_SERVICE_URL=localhost:5005
# Must match SERVICE_TOKEN in the separate snap-vocab-ai repository's .env; leave empty if the AI port is private.
AI_SERVICE_TOKEN=
# Optional: override the backend -> AI read timeout (ms).
# AI_SERVICE_READ_TIMEOUT_MS=60000
