# Cấu hình y hệt "chế độ sản phẩm" của notebook object_scan_florence2 (cell 25).
# Kích hoạt: sao chép đè lên .env rồi khởi động lại ai-service
#   copy .env.notebook .env
#
# YÊU CẦU PHẦN CỨNG: GPU NVIDIA >= 12GB VRAM (notebook chạy trên Colab T4 16GB).
# Chạy CPU vẫn được nhưng cần >= 10GB RAM trống và mỗi ảnh mất rất lâu
# (nhiều phút tới hàng chục phút) — xem ghi chú cuối file.
#
# !! QUAN TRỌNG - DEVICE=cuda KHÔNG CHỈ CẦN ĐỔI FILE NÀY !!
# venv hiện tại đang cài torch bản CPU-only (2.5.1+cpu, không có CUDA).
# Đặt DEVICE=cuda với bản torch đó -> service crash lúc khởi động.
# Muốn dùng GPU phải cài lại torch bản CUDA trước:
#   .venv\Scripts\pip.exe uninstall -y torch torchvision
#   .venv\Scripts\pip.exe install torch==2.5.1 torchvision==0.20.1 \
#       --index-url https://download.pytorch.org/whl/cu121
# Nếu vẫn chạy CPU thì đổi dòng dưới thành DEVICE=cpu.

DEVICE=cuda
CORS_ORIGINS=["*"]
MAX_UPLOAD_MB=15

# Cell 4 của notebook
FLORENCE_MODEL_ID=microsoft/Florence-2-large
SAM_MODEL_TYPE=vit_h
CLIP_MODEL_ID=openai/clip-vit-base-patch32

# Cell 8 của notebook
FLORENCE_MAX_NEW_TOKENS=1024
FLORENCE_NUM_BEAMS=3

# Cell 25 của notebook (chế độ sản phẩm)
ENABLE_TILED_OD=true
ENABLE_SELF_GROUNDING=true
ENABLE_BASE_VOCAB=true
ENABLE_EXTRA_VOCAB=true
MAX_CARDS_PER_LABEL=1
STRICT_DICTIONARY_FILTER=false

# Cell 10 của notebook
REQUIRE_DICTIONARY_LABELS=true
CLIP_BASE_THRESHOLD=0.23
CLIP_RANK_MARGIN=0.02
SAM_IOU_WEIGHT=0.7
SAM_STABILITY_WEIGHT=0.3
SAM_MIN_MASK_AREA_PX=400
SAM_MIN_MASK_BOX_RATIO=0.05
SAM_CROP_PADDING=4

# GHI CHÚ VỀ TỐC ĐỘ
# ENABLE_BASE_VOCAB quét ~154 từ vựng nền, chia cụm 12 từ -> thêm ~13 lượt gọi
# model mỗi ảnh. Cộng với ENABLE_TILED_OD (+4 lượt) và ENABLE_SELF_GROUNDING (+2),
# một ảnh cần khoảng 20 lượt gọi Florence-2 thay vì 2.
# Trên GPU: vài giây tới ~30 giây/ảnh — chấp nhận được.
# Trên CPU: nhiều phút/ảnh, vượt xa timeout 180s của app (features/scan/api.ts)
# và 600s của backend (application-dev.yaml) -> app sẽ báo lỗi dù AI vẫn đang chạy.
