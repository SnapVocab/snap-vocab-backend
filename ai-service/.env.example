DEVICE=auto
# Only the backend calls this service; CORS is for a local debugging UI only.
CORS_ORIGINS=[]
MAX_UPLOAD_MB=10
# Must match ai-service.service-token in the backend. Empty = no auth (backend-only network).
SERVICE_TOKEN=

FLORENCE_MODEL_ID=microsoft/Florence-2-base
CLIP_MODEL_ID=openai/clip-vit-base-patch32

# Measured: 3 -> 1 is 24% faster but loses 46% of the correct labels. Keep 3.
FLORENCE_NUM_BEAMS=3
# Prompts fed to generate() in one call. Only equal-length prompts can batch
# (Florence-2 does not mask padding). Lower it first on CUDA OOM.
FLORENCE_BATCH_SIZE=4

ENABLE_TILED_OD=false
ENABLE_SELF_GROUNDING=true
ENABLE_BASE_VOCAB=false
ENABLE_EXTRA_VOCAB=false

# Set to false once the client draws its own boxes: it removes a WEBP encode and
# a base64 payload that inflates the response by ~33%.
RETURN_ANNOTATED_IMAGE=true

# Keep a timing baseline that survives closing the terminal.
# TIMING_LOG_FILE=logs/timing.log
