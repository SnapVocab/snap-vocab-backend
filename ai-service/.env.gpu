# Cấu hình cho máy có GPU NVIDIA ~4GB VRAM.
# Kích hoạt: copy .env.gpu .env  rồi khởi động lại ai-service
#
# !! BƯỚC BẮT BUỘC TRƯỚC TIÊN: cài lại torch bản CUDA !!
# venv mặc định đang cài torch CPU-only. Để DEVICE=cuda với bản đó -> crash.
#   .venv\Scripts\pip.exe uninstall -y torch torchvision
#   .venv\Scripts\pip.exe install torch==2.5.1 torchvision==0.20.1 ^
#       --index-url https://download.pytorch.org/whl/cu121
# Kiểm tra:
#   .venv\Scripts\python.exe -c "import torch; print(torch.cuda.is_available())"
#   -> phải in ra True

DEVICE=cuda
# Only the backend calls this service; CORS is for a local debugging UI only.
CORS_ORIGINS=[]
MAX_UPLOAD_MB=10
# Must match ai-service.service-token in the backend. Empty = no auth (backend-only network).
SERVICE_TOKEN=

# Florence-2-large chính xác hơn base rõ rệt (phân biệt turkey/chicken,
# shirt/tank top) và trên GPU thì chênh lệch tốc độ không còn đáng kể.
# fp16 chiếm ~1.5GB weights, đỉnh ~2.5-3GB khi sinh text -> vừa 4GB.
FLORENCE_MODEL_ID=microsoft/Florence-2-large
CLIP_MODEL_ID=openai/clip-vit-base-patch32

# --- Hai tham số quyết định tốc độ trên GPU ---
# Decode bị chặn bởi băng thông nạp trọng số chứ không phải compute, nên chạy
# nhiều prompt song song gần như miễn phí. Lưu ý: Florence-2 không mask padding,
# nên chỉ các prompt dài BẰNG NHAU mới gộp được -> tiled OD (4 lượt, prompt giống
# hệt) gộp trọn vẹn; base-vocab (text khác nhau) chỉ gộp trong nhóm cùng độ dài.
FLORENCE_BATCH_SIZE=4
# ĐÃ ĐO LẠI TRÊN CPU: beam 3 -> 1 chỉ nhanh hơn 24% nhưng mất 46% số nhãn ĐÚNG
# (13/33 còn 7/33) và bịa ra vật không có trong ảnh. Giữ 3.
# Nếu thiếu VRAM thì hạ FLORENCE_BATCH_SIZE trước, đừng hạ beam.
FLORENCE_NUM_BEAMS=3

# Ảnh lớn hơn giúp bắt vật nhỏ mà gần như không tốn thêm thời gian.
# CHỈ có tác dụng khi ENABLE_TILED_OD=true (Florence-2 resize về 768 bên trong).
MAX_INPUT_SIZE=1600

# Bật đủ các bước cho độ phủ cao.
ENABLE_TILED_OD=true
ENABLE_SELF_GROUNDING=true
ENABLE_DENSE_CAPTION=false
# CÂN NHẮC: base-vocab thêm ~7 lượt prompt để đi từ 14/33 lên 18/33 nhãn đúng,
# đổi lại ~40% nhãn sai. Tắt nó là cách giảm thời gian rẻ nhất, và còn tăng
# độ chính xác. Bật khi ưu tiên độ phủ hơn độ sạch.
ENABLE_BASE_VOCAB=true
# EXTRA_VOCAB đo được là LÀM TỆ HƠN (ít nhãn đúng hơn mà chậm hơn) -> để false.
ENABLE_EXTRA_VOCAB=false

# BASE_VOCAB hay sinh nhãn sai (laptop/cake/sandwich không có trong ảnh).
# Nâng ngưỡng này lên 0.26-0.30 nếu thấy nhiều nhãn rác.
CLIP_BASE_THRESHOLD=0.23

# Đặt false khi app tự vẽ box từ toạ độ trong response: bỏ được một lượt encode
# WEBP và payload base64 phình 33%.
RETURN_ANNOTATED_IMAGE=true

# Giữ lại số đo để so sánh trước/sau khi tối ưu.
TIMING_LOG_FILE=logs/timing.log

# NẾU GẶP LỖI "CUDA out of memory" (theo thứ tự này):
#   1. FLORENCE_BATCH_SIZE=2  rồi 1   (service tự lùi về chạy tuần tự nếu batch
#      lỗi, nên sẽ chậm đi chứ không hỏng request)
#   2. MAX_INPUT_SIZE=1200
#   3. ENABLE_BASE_VOCAB=false (đỡ phải nạp thêm CLIP)
#   4. Cuối cùng mới quay về FLORENCE_MODEL_ID=microsoft/Florence-2-base
